{
  "service": "entregas-service",
  "port": 3005,
  "database": "PostgreSQL",
  "responsibility": "Gestión de entregas del día, cambio de estado de reparto, confirmación de entrega. Vendedor = repartidor en MVP. Sin mapa GPS (feature futuro).",
  "endpoints": [
    {
      "path": "/deliveries",
      "method": "GET",
      "auth": "VENDEDOR",
      "request": { "fecha": "date?", "vendedorId": "uuid" },
      "response": [{ "id": "uuid", "orderId": "uuid", "estado": "pendiente|en_camino|entregada", "cliente": "object", "direccion": "object", "fechaAsignacion": "date" }]
    },
    {
      "path": "/deliveries/:id",
      "method": "GET",
      "auth": "VENDEDOR|ADMIN",
      "request": {},
      "response": { "id": "uuid", "orderId": "uuid", "vendedorId": "uuid", "estado": "string", "direccion": "object", "fechaAsignacion": "date", "fechaEntrega": "date?", "notas": "string?" }
    },
    {
      "path": "/deliveries/:id/status",
      "method": "PATCH",
      "auth": "VENDEDOR",
      "request": { "estado": "en_camino|entregada", "notas": "string?" },
      "response": { "id": "uuid", "estado": "string", "updated": "boolean" }
    }
  ]
}
