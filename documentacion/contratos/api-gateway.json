{
  "service": "api-gateway",
  "port": 3000,
  "responsibility": "Punto de entrada único. Routing, autenticación JWT, rate limiting, forwarding TCP a microservicios. Nginx (80) → Gateway (3000).",
  "routes": [
    { "path": "/auth/*", "target": "auth-service", "port": 3001, "auth": false },
    { "path": "/users/*", "target": "user-service", "port": 3002, "auth": true },
    { "path": "/products/*", "target": "products-service", "port": 3003, "auth": true },
    { "path": "/orders/*", "target": "orders-service", "port": 3004, "auth": true },
    { "path": "/cart/*", "target": "orders-service", "port": 3004, "auth": true },
    { "path": "/deliveries/*", "target": "entregas-service", "port": 3005, "auth": true },
    { "path": "/logs/*", "target": "notifications-service", "port": 3006, "auth": true },
    { "path": "/public/*", "target": "user-service", "port": 3002, "auth": false }
  ]
}
