{
  "service": "notifications-service",
  "port": 3006,
  "database": "MongoDB",
  "responsibility": "Activity logs del sistema. Escucha todos los eventos del bus Redis y los persiste como auditoría.",
  "collections": {
    "activity_logs": {
      "description": "Registro de eventos de auditoría de todos los servicios",
      "fields": {
        "_id": "ObjectId (PK)",
        "usuario_id": "UUID? (nullable para eventos no asociados a usuario)",
        "accion": "string (ej: OrderCreated, UserCreated, DeliveryStarted)",
        "entidad_tipo": "string (ej: order, user, delivery)",
        "entidad_id": "UUID?",
        "metadata": "object (datos adicionales del evento)",
        "servicio": "string (auth, user, products, orders, deliveries)",
        "created_at": "timestamp"
      }
    }
  },
  "endpoints": [
    {
      "path": "/logs",
      "method": "GET",
      "auth": "ADMIN",
      "request": { "servicio": "string?", "accion": "string?", "usuarioId": "uuid?", "fechaDesde": "date?", "fechaHasta": "date?" },
      "response": [{ "id": "uuid", "servicio": "string", "accion": "string", "entidad_tipo": "string", "metadata": "object", "timestamp": "date" }]
    }
  ]
}
