{
  "service": "analytics-service",
  "port": 3005,
  "database": "MySQL",
  "responsibility": "Reportes, métricas, historial de ventas OLAP, datos de solo lectura.",
  "endpoints": [
    {
      "path": "/analytics/ventas/cliente",
      "method": "GET",
      "request": { "vendedorId": "uuid", "fechaDesde": "date?", "fechaHasta": "date?" },
      "response": [{ "clienteId": "uuid", "nombre": "string", "totalVentas": "number", "cantidadPedidos": "number", "ultimoPedido": "date" }]
    },
    {
      "path": "/analytics/ventas/producto",
      "method": "GET",
      "request": { "vendedorId": "uuid", "fechaDesde": "date?", "fechaHasta": "date?" },
      "response": [{ "productId": "uuid", "nombre": "string", "unidadesVendidas": "number", "montoTotal": "number" }]
    },
    {
      "path": "/analytics/historial/:cliente",
      "method": "GET",
      "request": { "clienteId": "uuid" },
      "response": [{ "orderId": "uuid", "fecha": "date", "total": "number", "estado": "string", "productos": "array" }]
    },
    {
      "path": "/analytics/metricas",
      "method": "GET",
      "request": { "vendedorId": "uuid", "rango": "diario|mensual|anual" },
      "response": { "ventasTotales": "number", "pedidosTotales": "number", "ticketPromedio": "number", "clientesNuevos": "number" }
    },
    {
      "path": "/analytics/dashboard",
      "method": "GET",
      "request": { "vendedorId": "uuid" },
      "response": { "pedidosPendientes": "number", "pedidosConfirmados": "number", "ventasDia": "number", "ventasSemana": "number", "topProductos": "array" }
    }
  ]
}