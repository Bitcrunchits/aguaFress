{
  "service": "api-gateway",
  "port": 3000,
  "responsibility": "Punto de entrada único. Routing, autenticación JWT, rate limiting, forwarding a microservicios.",
  "security_rules": [
    "El gateway extrae el userId del token JWT y lo pasa a los servicios en los headers.",
    "Rate limiting: implementar en endpoints de login (máx 5 intentos/min)."
  ],
  "routes": [
    { "path": "/auth/*", "target": "usuario-service (módulo auth)", "port": 3001, "auth_required": false },
    { "path": "/users/*", "target": "usuario-service (módulo users)", "port": 3001, "auth_required": true },
    { "path": "/qr/*", "target": "usuario-service (módulo users)", "port": 3001, "auth_required": false },
    { "path": "/products/*", "target": "products-service", "port": 3003, "auth_required": false },
    { "path": "/categories/*", "target": "products-service", "port": 3003, "auth_required": false },
    { "path": "/brands/*", "target": "products-service", "port": 3003, "auth_required": false },
    { "path": "/orders/*", "target": "orders-service", "port": 3004, "auth_required": true },
    { "path": "/cart/*", "target": "orders-service", "port": 3004, "auth_required": true },
    { "path": "/deliveries/*", "target": "entregas-service", "port": 3005, "auth_required": true },
    { "path": "/activity-logs/*", "target": "notifications-service", "port": 3006, "auth_required": true },
    { "path": "/super-admin/*", "target": "usuario-service (módulo auth)", "port": 3001, "auth_required": true }
  ]
}
