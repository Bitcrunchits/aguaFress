{
  "service": "orders-service",
  "port": 3014,
  "database": "PostgreSQL",
  "orm": "Prisma",
  "responsibility": "Gestión de carrito, pedidos, estados y facturas B/C. Solo contra_entrega como método de pago.",
  "security_rules": [
    "⚠️ userId/clienteId NUNCA viene del body. Se extrae del token JWT en el middleware."
  ],
  "product_dependency_rule": "Hasta que exista un adaptador real de products-service, cart.items_add, cart.items_update y orders.create pueden devolver 503 controlado. Lecturas, cart.items_delete y operaciones de estado no dependen del catálogo y siguen disponibles.",
  "public_entrypoint": {
    "type": "api-gateway",
    "base_path": "/api/v1/{service}/{action}",
    "note": "orders-service permanece TCP-only; el frontend no consume HTTP directo del microservicio."
  },
  "tcp_patterns": {
    "cart": ["cart.get", "cart.items_add", "cart.items_update", "cart.items_delete"],
    "orders": ["orders.list", "orders.get_by_id", "orders.create", "orders.status_update", "orders.cancel", "orders.confirm"]
  },
  "gateway_routes": [
    { "path": "/api/v1/cart/get", "method": "GET", "tcp_pattern": "cart.get", "auth": "CLIENTE" },
    { "path": "/api/v1/cart/items/add", "method": "POST", "tcp_pattern": "cart.items_add", "auth": "CLIENTE" },
    { "path": "/api/v1/cart/items/update", "method": "PATCH", "tcp_pattern": "cart.items_update", "auth": "CLIENTE" },
    { "path": "/api/v1/cart/items/delete", "method": "DELETE", "tcp_pattern": "cart.items_delete", "auth": "CLIENTE", "request": { "cartId": "string", "productoId": "string" } },
    { "path": "/api/v1/orders/list", "method": "GET", "tcp_pattern": "orders.list", "auth": "CLIENTE|VENDEDOR|SUPER_ADMIN" },
    { "path": "/api/v1/orders/get-by-id?id={orderId}", "method": "GET", "tcp_pattern": "orders.get_by_id", "auth": "CLIENTE|VENDEDOR|SUPER_ADMIN" },
    { "path": "/api/v1/orders/create", "method": "POST", "tcp_pattern": "orders.create", "auth": "CLIENTE" },
    { "path": "/api/v1/orders/status/update", "method": "PATCH", "tcp_pattern": "orders.status_update", "auth": "VENDEDOR" },
    { "path": "/api/v1/orders/cancel", "method": "POST", "tcp_pattern": "orders.cancel", "auth": "CLIENTE" },
    { "path": "/api/v1/orders/confirm", "method": "POST", "tcp_pattern": "orders.confirm", "auth": "VENDEDOR" }
  ],
  "events_publishes": ["orders-stream: OrderCreated, OrderStatusChanged"],
  "events_consumes": ["deliveries-stream: DeliveryCompleted"],
  "events_listens": ["deliveries-stream: DeliveryStarted, DeliveryCompleted, DeliveryStatusChanged"],
  "endpoints": [
    {
      "path": "/orders",
      "method": "GET",
      "auth": "CLIENTE|VENDEDOR",
      "request": { "estado?": "OrderEstado", "page?": "number", "limit?": "number" },
      "response": { "data": [{ "id": "uuid", "pedidoNumero": "string", "estado": "OrderEstado", "total": "number", "clienteNombre?": "string", "clienteApellido?": "string", "createdAt": "string (ISO 8601)" }], "pagination": { "page": "number", "limit": "number", "total": "number", "totalPages": "number" } }
    },
    {
      "path": "/orders/:id",
      "method": "GET",
      "auth": "CLIENTE|VENDEDOR",
      "request": {},
      "response": { "id": "uuid", "pedidoNumero": "string", "cliente": { "id": "uuid", "nombre": "string", "apellido?": "string" }, "items": [{ "productId": "uuid", "nombre": "string", "cantidad": "number", "precioUnitario": "number" }], "totalSinIva": "number", "iva": "number", "total": "number", "estado": "OrderEstado", "metodoPago": "contra_entrega", "direccion": "DireccionEntrega", "createdAt": "string (ISO 8601)" }
    },
    {
      "path": "/orders",
      "method": "POST",
      "auth": "CLIENTE",
      "notes": "Crea pedido desde el carrito del usuario autenticado. Los items se toman del carrito, no del body.",
      "request": { "metodoPago": "contra_entrega", "direccion": "DireccionEntrega", "observaciones?": "string" },
      "response": { "id": "uuid", "pedidoNumero": "string", "estado": "pendiente", "total": "number" }
    },
    {
      "path": "/orders/:id/status",
      "method": "PATCH",
      "auth": "VENDEDOR",
      "notes": "Transiciones válidas para vendedor: pendiente→confirmado→en_camino→entregado y cancelaciones según máquina de estados.",
      "request": { "estado": "confirmado|en_camino|entregado|cancelado" },
      "response": { "id": "uuid", "estado": "OrderEstado", "updated": "boolean" }
    },
    {
      "path": "/orders/:id/cancelar",
      "method": "POST",
      "auth": "CLIENTE",
      "notes": "El cliente solo puede cancelar pedidos propios en estado pendiente.",
      "request": { "motivo?": "string" },
      "response": { "id": "uuid", "estado": "cancelado" }
    },
    {
      "path": "/orders/:id/confirmar",
      "method": "POST",
      "auth": "VENDEDOR",
      "notes": "El vendedor confirma el pedido como parte del ciclo de vida operativo. Opcionalmente puede actualizar dirección de entrega.",
      "request": { "direccion?": "DireccionEntrega" },
      "response": { "orderId": "uuid", "estado": "confirmado", "mensaje": "string" }
    },
    {
      "path": "/cart",
      "method": "GET",
      "auth": "CLIENTE",
      "request": {},
      "response": { "id": "uuid", "clienteId": "uuid", "vendedorId": "uuid", "items": [{ "id": "uuid", "productoId": "uuid", "nombre": "string", "cantidad": "number", "precioUnitario": "number", "subtotal": "number" }], "total": "number", "expiresAt": "string (ISO 8601)" }
    },
    {
      "path": "/cart/items",
      "method": "POST",
      "auth": "CLIENTE",
      "notes": "Agrega un item al carrito del usuario autenticado.",
      "request": { "cartId?": "uuid", "productoId": "uuid", "cantidad": "number" },
      "response": "CartResponse",
      "unavailable_behavior": "Puede devolver 503 controlado hasta que exista adaptador real de productos. Duplicate add incrementa cantidad."
    },
    {
      "path": "/cart/items/:id",
      "method": "PATCH",
      "auth": "CLIENTE",
      "request": { "cartId": "uuid", "productoId": "uuid", "cantidad": "number" },
      "response": "CartResponse",
      "unavailable_behavior": "Puede devolver 503 controlado hasta que exista adaptador real de productos. Si el item no existe, devuelve 404 y no lo crea."
    },
    {
      "path": "/cart/items/:id",
      "method": "DELETE",
      "auth": "CLIENTE",
      "request": { "cartId": "uuid", "productoId": "uuid" },
      "response": "CartResponse"
    }
  ]
}
