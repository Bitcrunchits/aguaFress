{
  "service": "products-service",
  "port": 3003,
  "database": "PostgreSQL",
  "orm": "Prisma",
  "responsibility": "Catálogo de productos, categorías, marcas, stock, búsquedas.",
  "security_rules": [
    "⚠️ vendedorId NUNCA viene del body en create/update. Se extrae del token JWT.",
    "⚠️ El precio se calcula server-side. El frontend manda precioSinIva, el service calcula precioFinal."
  ],
  "events_publishes": ["products-stream: ProductUpdated, ProductDeleted"],
  "endpoints": [
    {
      "path": "/products",
      "method": "GET",
      "auth": "VENDEDOR|Público",
      "request": { "vendedorId?": "uuid", "categoria?": "string", "disponibles?": "boolean", "page?": "number", "limit?": "number" },
      "response": { "data": [{ "id": "uuid", "nombre": "string", "descripcion?": "string", "precioSinIva": "number", "precioFinal": "number", "imagen?": "url", "stock": "number", "marca?": "string", "categoria?": "string", "vendedorId": "uuid", "activo": "boolean", "mostrarPrecio?": "boolean" }], "pagination": { "page": "number", "limit": "number", "total": "number", "totalPages": "number" } }
    },
    {
      "path": "/products/:id",
      "method": "GET",
      "auth": "Público",
      "request": {},
      "response": { "id": "uuid", "nombre": "string", "descripcion?": "string", "precioSinIva": "number", "precioFinal": "number", "imagen?": "url", "stock": "number", "marca?": "string", "categoria?": "string", "vendedorId": "uuid", "activo": "boolean", "mostrarPrecio?": "boolean" }
    },
    {
      "path": "/products",
      "method": "POST",
      "auth": "VENDEDOR",
      "request": { "nombre": "string", "descripcion?": "string", "precioSinIva": "number", "categoriaId": "uuid", "marcaId?": "uuid", "imagen?": "url", "stock": "number", "mostrarPrecio?": "boolean" },
      "response": { "id": "uuid", "created": "boolean" }
    },
    {
      "path": "/products/:id",
      "method": "PATCH",
      "auth": "VENDEDOR",
      "request": { "nombre?": "string", "descripcion?": "string", "precioSinIva?": "number", "stock?": "number", "imagen?": "url", "activo?": "boolean", "mostrarPrecio?": "boolean" },
      "response": { "id": "uuid", "updated": "boolean" }
    },
    {
      "path": "/products/:id",
      "method": "DELETE",
      "auth": "VENDEDOR",
      "request": {},
      "response": { "deleted": "boolean" }
    },
    {
      "path": "/products/search",
      "method": "GET",
      "auth": "Público",
      "request": { "q": "string", "vendedorId?": "uuid" },
      "response": [{ "id": "uuid", "nombre": "string", "precioFinal": "number", "imagen?": "url", "mostrarPrecio?": "boolean" }]
    },
    {
      "path": "/categories",
      "method": "GET",
      "auth": "Público",
      "request": { "vendedorId": "uuid" },
      "response": [{ "id": "uuid", "nombre": "string", "orden": "number", "vendedorId": "uuid" }]
    },
    {
      "path": "/brands",
      "method": "GET",
      "auth": "Público",
      "request": { "vendedorId": "uuid" },
      "response": [{ "id": "uuid", "nombre": "string", "vendedorId": "uuid" }]
    }
  ]
}
