{
  "service": "notifications-service",
  "transport": "TCP",
  "database": "MongoDB",
  "orm": "Mongoose",
  "responsibility": "Owns MongoDB activity_logs and exposes read-only activity-log queries to the gateway for SUPER_ADMIN users.",
  "activityLogResults": ["success", "failure"],
  "tcp_patterns": [
    {
      "pattern": "activity_logs.list",
      "auth": "SUPER_ADMIN",
      "request": {
        "source?": "string",
        "action?": "string",
        "actor?": "string",
        "result?": "success | failure",
        "from?": "string (ISO 8601)",
        "to?": "string (ISO 8601)",
        "page?": "number",
        "limit?": "number"
      },
      "response": {
        "data": [
          {
            "id": "string",
            "createdAt": "string (ISO 8601)",
            "source": "string",
            "action": "string",
            "actor": {
              "userId?": "string (UUID)",
              "email?": "string",
              "role?": "super_admin | vendedor | cliente"
            },
            "entity": {
              "type?": "string",
              "id?": "string"
            },
            "result": "success | failure",
            "summary": "string"
          }
        ],
        "meta": {
          "page": "number",
          "limit": "number",
          "total": "number",
          "totalPages": "number"
        }
      }
    },
    {
      "pattern": "activity_logs.get-by-id",
      "auth": "SUPER_ADMIN",
      "request": {
        "id": "string"
      },
      "response": {
        "data": {
          "id": "string",
          "createdAt": "string (ISO 8601)",
          "source": "string",
          "action": "string",
          "actor": {
            "userId?": "string (UUID)",
            "email?": "string",
            "role?": "super_admin | vendedor | cliente"
          },
          "entity": {
            "type?": "string",
            "id?": "string"
          },
          "result": "success | failure",
          "summary": "string",
          "metadata": "Record<string, unknown>",
          "requestId?": "string"
        }
      }
    }
  ],
  "public_gateway_mutations": []
}
