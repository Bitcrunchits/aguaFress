# ───────────────────────────────────────────────────────────────
#  entregas-service — Variables de Entorno (desarrollo local)
#  ───────────────────────────────────────────────────────────────
#  Este .env.example se commitea. El .env real está ignorado.
#  Copiar a .env, reemplazar placeholders <...> antes de correr,
#  y nunca usar placeholders ni secretos locales en producción.
# ───────────────────────────────────────────────────────────────

# ─── Base de datos ────────────────────────────────────────────────
# LOCAL DEVELOPMENT ONLY: replace placeholder before running locally.
DATABASE_URL="postgresql://postgres:<replace-with-local-postgres-password>@localhost:5433/agua_entregas"

# ─── Redis ────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── TCP transport ────────────────────────────────────────────────
TCP_PORT=3015

# ─── Conexión a usuario-service ──────────────────────────────────
USUARIO_SERVICE_HOST=localhost
USUARIO_SERVICE_TCP_PORT=3011

# ─── Timeouts ─────────────────────────────────────────────────────
TCP_TIMEOUT_MS=5000
