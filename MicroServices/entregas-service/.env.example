# ─── Base de datos ────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/agua_entregas"

# ─── Redis ────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── TCP transport ────────────────────────────────────────────────
TCP_PORT=3015

# ─── Conexión a usuario-service ──────────────────────────────────
USUARIO_SERVICE_HOST=localhost
USUARIO_SERVICE_TCP_PORT=3011

# ─── Timeouts ─────────────────────────────────────────────────────
TCP_TIMEOUT_MS=5000
