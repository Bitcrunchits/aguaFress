# --- Node.js dependencies ---
node_modules/
package-lock.json
npm-debug.log*
yarn-debug.log*

# --- Environment variables ---
.env
.env.local
.env.*.local

# --- Build outputs ---
dist/
build/
*.log

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db

# --- MCP Server (credenciales de Jira) ---
mcp/jira-mcp-server/node_modules/
mcp/jira-mcp-server/.env
mcp/jira-mcp-server/package-lock.json

# --- Test / Coverage ---
coverage/
.nyc_output/

# --- Secrets ---
*.pem
*.key
credentials.json