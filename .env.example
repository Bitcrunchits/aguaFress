# ───────────────────────────────────────────────────────────────
#  AguaFress — Variables de Entorno (desarrollo local)
#  ───────────────────────────────────────────────────────────────
#  Copiar a .env y completar:
#    cp .env.example .env
#
#  IMPORTANTE:
#  - Este archivo es solo un ejemplo para desarrollo.
#  - Nunca commitear archivos .env reales.
#  - docker-compose.yml todavía reutiliza el .env raíz por conveniencia local.
#    Antes de producción, separar envs por servicio/secrets manager.
# ───────────────────────────────────────────────────────────────

# ─── Secrets compartidos de auth ───────────────────────────────
JWT_SECRET="cambiar-en-prod-por-seguridad-min-32-chars"
JWT_REFRESH_SECRET="cambiar-tambien-este-refresh-secret"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Redis local ───────────────────────────────────────────────
REDIS_URL="redis://redis:6379"

# ─── usuario-service (TCP-only, puerto interno 3011) ───────────
# TODO producción: usar DB propia del usuario-service, no DB compartida.
# En desarrollo histórico puede existir `agua`; no usar esto como modelo prod.
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/agua"
TCP_PORT=3011
NODE_ENV=development

# ─── orders-service (TCP-only, puerto interno 3014) ────────────
# docker-compose.yml inyecta DATABASE_URL y TCP_PORT explícitamente al contenedor.
# Para correr orders-service fuera de compose, usar en el entorno de ese proceso:
# DATABASE_URL="postgresql://postgres:postgres@postgres:5432/agua_orders"
# TCP_PORT=3014

# ─── api-gateway (única entrada HTTP pública) ─────────────────
PORT=3000
USUARIO_SERVICE_HOST="usuario-service"
USUARIO_SERVICE_TCP_PORT=3011
ORDERS_SERVICE_HOST="orders-service"
ORDERS_SERVICE_TCP_PORT=3014
TCP_TIMEOUT_MS=5000
PAYLOAD_LIMIT="1mb"

# ─── Rate limits gateway ──────────────────────────────────────
RATE_LIMIT_AUTH_SENSITIVE_TTL_MS=60000
RATE_LIMIT_AUTH_SENSITIVE_MAX=10
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_PUBLIC_TTL_MS=60000
RATE_LIMIT_PUBLIC_MAX=300
