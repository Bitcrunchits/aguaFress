# ───────────────────────────────────────────────────────────────
#  AguaFress — Variables de Entorno (desarrollo local)
#  ───────────────────────────────────────────────────────────────
#  Copiar a .env y completar:
#    cp .env.example .env
#
#  IMPORTANTE:
#  - Este .env.example se commitea como espejo del entorno local.
#  - El .env real está ignorado y nunca debe commitearse.
#  - Reemplazar todos los placeholders <...> antes de levantar servicios.
#  - Nunca usar placeholders ni secretos locales en producción.
#  - docker-compose.yml lee estas variables explícitamente desde el .env raíz.
#    Antes de producción, separar envs por servicio/secrets manager.
# ───────────────────────────────────────────────────────────────

# ─── Secrets compartidos de auth ───────────────────────────────
JWT_SECRET="<replace-with-local-jwt-secret-min-32-chars>"
JWT_REFRESH_SECRET="<replace-with-local-jwt-refresh-secret-min-32-chars>"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── PostgreSQL local para docker compose ──────────────────────
POSTGRES_PASSWORD="<replace-with-local-postgres-password>"

# ─── Redis local ───────────────────────────────────────────────
REDIS_URL="redis://redis:6379"

# ─── BullMQ orders.create pilot ─────────────────────────────────
ORDERS_CREATE_QUEUE_NAME="orders.create"
ORDERS_CREATE_QUEUE_ATTEMPTS=3
ORDERS_CREATE_QUEUE_BACKOFF_MS=5000
ORDERS_CREATE_QUEUE_REMOVE_ON_COMPLETE=1000
ORDERS_CREATE_WORKER_CONCURRENCY=1

# ─── usuario-service (TCP-only, puerto interno 3011) ───────────
# TODO producción: usar DB propia del usuario-service, no DB compartida.
# En desarrollo histórico puede existir `agua`; no usar esto como modelo prod.
DATABASE_URL="postgresql://postgres:<replace-with-local-postgres-password>@postgres:5432/agua"
TCP_PORT=3011
NODE_ENV=development

# ─── products-service (TCP-only, puerto interno 3013) ──────────
# docker-compose.yml inyecta DATABASE_URL y TCP_PORT explícitamente al contenedor.
# Para correr products-service fuera de compose, usar en el entorno de ese proceso:
PRODUCTS_DATABASE_URL="postgresql://postgres:<replace-with-local-postgres-password>@postgres:5432/agua_products"
# DATABASE_URL="postgresql://postgres:<replace-with-local-postgres-password>@postgres:5432/agua_products"
# TCP_PORT=3013

# ─── orders-service (TCP-only, puerto interno 3014) ────────────
ORDERS_DATABASE_URL="postgresql://postgres:<replace-with-local-postgres-password>@postgres:5432/agua_orders"
# docker-compose.yml usa ORDERS_DATABASE_URL para inyectar DATABASE_URL al contenedor.
# También inyecta REDIS_URL y defaults BullMQ para el piloto orders.create.
# Para correr orders-service fuera de compose, exportar DATABASE_URL con el mismo valor.
# TCP_PORT=3014

# ─── api-gateway (única entrada HTTP pública) ─────────────────
PORT=3000
USUARIO_SERVICE_HOST="usuario-service"
USUARIO_SERVICE_TCP_PORT=3011
ORDERS_SERVICE_HOST="orders-service"
ORDERS_SERVICE_TCP_PORT=3014
NOTIFICATIONS_SERVICE_HOST="notifications-service"
NOTIFICATIONS_SERVICE_TCP_PORT=3016
ENTREGAS_SERVICE_HOST="entregas-service"
ENTREGAS_SERVICE_TCP_PORT=3015
TCP_TIMEOUT_MS=5000
PAYLOAD_LIMIT="1mb"

# ─── entregas-service (TCP-only, puerto interno 3015) ────────────
# docker-compose.yml inyecta DATABASE_URL y TCP_PORT explícitamente al contenedor.
# Para correr entregas-service fuera de compose, usar en el entorno de ese proceso:
ENTREGAS_DATABASE_URL="postgresql://postgres:<replace-with-local-postgres-password>@postgres:5432/agua_entregas"
# DATABASE_URL="postgresql://postgres:<replace-with-local-postgres-password>@postgres:5432/agua_entregas"
# TCP_PORT=3015
ENTREGAS_SERVICE_HOST="entregas-service"
ENTREGAS_SERVICE_TCP_PORT=3015

# ─── Rate limits gateway ──────────────────────────────────────
RATE_LIMIT_AUTH_SENSITIVE_TTL_MS=60000
RATE_LIMIT_AUTH_SENSITIVE_MAX=10
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_PUBLIC_TTL_MS=60000
RATE_LIMIT_PUBLIC_MAX=300
