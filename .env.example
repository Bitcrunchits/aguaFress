# ───────────────────────────────────────────────────────────────
#  AguaFress — Variables de Entorno (desarrollo)
#  ───────────────────────────────────────────────────────────────
#  Copiar a .env y completar:
#    cp .env.example .env
# ───────────────────────────────────────────────────────────────

# ─── Base de datos ───────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/agua"

# ─── JWT ─────────────────────────────────────────────────────
JWT_SECRET="cambiar-en-prod-por-seguridad-min-32-chars!!"
JWT_REFRESH_SECRET="cambiar-tambien-este-refresh-secret!!"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL="redis://redis:6379"

# ─── usuario-service ──────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── api-gateway ──────────────────────────────────────────────
# docker-compose.yml fuerza PORT=3000 para gateway y usa estas TCP env.
USUARIO_SERVICE_HOST="usuario-service"
USUARIO_SERVICE_TCP_PORT=3001
